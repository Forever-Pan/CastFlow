# Copy to .env and fill in your own endpoint, credential, and model name.
# .env is private and ignored by Git. Shell environment variables take precedence.
OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
MODEL=grok-4

# Serve a trained forecasting checkpoint separately before enabling inference.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8002/v1
LOCAL_MODEL_NAME=castflow-forecast
LOCAL_MODEL_API_KEY=EMPTY

# Explicit settings for the example; these do not certify historical run settings.
CASTFLOW_USE_API=true
CASTFLOW_FORECASTING_MAX_TOKENS=5000
CASTFLOW_API_TIMEOUT=60
CASTFLOW_API_MAX_RETRIES=2
MAX_REFLECTION_LOOPS=3
MAX_TEST_RETRY_LOOPS=10
PARALLEL_PLAN_K=4
